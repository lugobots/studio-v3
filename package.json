{
  "name": "studio-v3",
  "version": "0.1.0",
  "description": "Studio v3 desktop application",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "pack:win": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "ai.lugobots.studio",
    "productName": "Lugo Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "Lugo-Studio-Windows-${version}.${ext}"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  }
}
